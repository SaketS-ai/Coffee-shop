# ==============================================================================
# Social Cup Frontend Environment Variables (.env.example)
# ==============================================================================
# NOTE: Vite bakes VITE_* variables into the static JavaScript bundle at BUILD TIME.
# Do NOT store secret credentials (API keys, private tokens) in frontend variables.

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:5000/api"

# ------------------------------------------------------------------------------
# 2. PRODUCTION (AWS S3 + CloudFront Build Step)
# ------------------------------------------------------------------------------
# Set this variable in your CI/CD pipeline (e.g. GitHub Actions, AWS CodeBuild)
# before running `npm run build`. Point this to your backend domain:
# VITE_API_URL="https://api.socialcup.com/api"
