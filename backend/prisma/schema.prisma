generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  BARISTA
  ADMIN

  @@map("user_role")
}

enum CreditLedgerType {
  SUBSCRIPTION
  REDEMPTION
  VOID
  RESET

  @@map("credit_ledger_type")
}

enum RedemptionStatus {
  PENDING
  REDEEMED
  EXPIRED
  VOID

  @@map("redemption_status")
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  password_hash String?  @db.VarChar(255)
  role          UserRole @default(MEMBER)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  memberships           Membership[]
  redemptions           Redemption[]   @relation("RedemptionUser")
  redemptions_scanned   Redemption[]   @relation("RedemptionRedeemedBy")
  redemptions_voided    Redemption[]   @relation("RedemptionVoidedBy")
  credit_ledger_entries CreditLedger[]
  reviews               Review[]
  payouts_recorded      Payout[]

  @@map("users")
}

model Cafe {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(255)
  address      String   @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(50)
  latitude     Float?
  longitude    Float?
  image_url    String?
  description  String?
  payout_rate  Decimal  @default(0) @db.Decimal(10, 2)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  drinks      Drink[]
  redemptions Redemption[]
  payouts     Payout[]

  @@map("cafes")
}

model Drink {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cafe_id      String   @db.Uuid
  name         String   @db.VarChar(255)
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  credit_price Int      @default(4)
  image_url    String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cafe        Cafe         @relation(fields: [cafe_id], references: [id], onDelete: Cascade)
  redemptions Redemption[]
  reviews     Review[]

  @@index([cafe_id])
  @@map("drinks")
}

// status is a plain VarChar + CHECK constraint, not a native enum, by
// deliberate choice (see migration 004) - keeps the allowed values a
// one-line migration change instead of an enum-type alter.
model Membership {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  status              String    @default("ACTIVE") @db.VarChar(20)
  start_date          DateTime  @default(now()) @db.Timestamptz(6)
  end_date            DateTime? @db.Timestamptz(6)
  current_cycle_start DateTime  @default(now()) @db.Timestamptz(6)
  cancelled_at        DateTime? @db.Timestamptz(6)
  credits             Int       @default(0)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("memberships")
}

// Append-only: rows are never updated, only inserted (see migration 005).
model CreditLedger {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String           @db.Uuid
  type          CreditLedgerType
  amount        Int
  balance_after Int
  reference_id  String?          @db.Uuid
  created_at    DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("credit_ledger")
}

model Redemption {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String           @db.Uuid
  cafe_id             String           @db.Uuid
  drink_id            String           @db.Uuid
  credit_price        Int
  token               String           @unique @db.VarChar(128)
  backup_code         String           @db.VarChar(6)
  status              RedemptionStatus @default(PENDING)
  expires_at          DateTime         @db.Timestamptz(6)
  redeemed_at         DateTime?        @db.Timestamptz(6)
  redeemed_by_user_id String?          @db.Uuid
  payout_rate         Decimal?         @db.Decimal(10, 2)
  voided_at           DateTime?        @db.Timestamptz(6)
  voided_by_user_id   String?          @db.Uuid
  void_reason         String?          @db.VarChar(500)
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  user        User  @relation("RedemptionUser", fields: [user_id], references: [id], onDelete: Cascade)
  cafe        Cafe  @relation(fields: [cafe_id], references: [id], onDelete: Cascade)
  drink       Drink @relation(fields: [drink_id], references: [id], onDelete: Cascade)
  redeemed_by User? @relation("RedemptionRedeemedBy", fields: [redeemed_by_user_id], references: [id])
  voided_by   User? @relation("RedemptionVoidedBy", fields: [voided_by_user_id], references: [id])
  review      Review?

  @@index([user_id])
  @@index([token])
  @@map("redemptions")
}

model Review {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  redemption_id String   @unique @db.Uuid
  drink_id      String   @db.Uuid
  rating        Int
  note          String?  @db.VarChar(500)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  redemption Redemption @relation(fields: [redemption_id], references: [id], onDelete: Cascade)
  drink      Drink      @relation(fields: [drink_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("reviews")
}

model Payout {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cafe_id             String   @db.Uuid
  period_start        DateTime @db.Timestamptz(6)
  period_end          DateTime @db.Timestamptz(6)
  amount              Decimal  @db.Decimal(10, 2)
  reference           String?  @db.VarChar(255)
  recorded_by_user_id String   @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  cafe        Cafe @relation(fields: [cafe_id], references: [id], onDelete: Cascade)
  recorded_by User @relation(fields: [recorded_by_user_id], references: [id])

  @@index([cafe_id])
  @@map("payouts")
}
