# Social Cup Backend Environment Variables

PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/socialcup_db"

# Frontend origin allowed to call this API (CORS)
CLIENT_URL="http://localhost:5173"

# Auth (Phase 2) - JWT signing secret and access token lifetime.
# Generate a real value for your local .env, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real secret here - this file only holds placeholders.
JWT_SECRET=
JWT_EXPIRES_IN=7d
