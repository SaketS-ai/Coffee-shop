# ==============================================================================
# Social Cup Backend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets.
# In AWS production, inject these variables via AWS ECS Task Definition secrets,
# AWS Systems Manager (SSM) Parameter Store, or AWS Secrets Manager.

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# When deployed behind an AWS Application Load Balancer or CloudFront, set to true
# to trust X-Forwarded-* headers and obtain the real client IP.
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/socialcup_db"

# AWS RDS Production Example (enforcing SSL & connection pool limits):
# DATABASE_URL="postgresql://dbadmin:YOUR_RDS_PASSWORD@socialcup-db.c123456789.us-east-1.rds.amazonaws.com:5432/socialcup?sslmode=require&connection_limit=15&pool_timeout=15"

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
# Allowed frontend origins. Supports comma-separated origins for production:
# e.g.: CLIENT_URL="https://socialcup.com,https://www.socialcup.com"
CLIENT_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 48-byte secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Rate limiting for public auth endpoints (/login, /register, /forgot-password)
AUTH_RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in ms
AUTH_RATE_LIMIT_MAX=20           # 20 attempts per window per IP

# ------------------------------------------------------------------------------
# 5. BACKGROUND JOBS SCHEDULER
# ------------------------------------------------------------------------------
# In a single-instance MVP deployment, set to true.
# If horizontally scaling the backend across multiple containers/instances,
# set to false and use Amazon EventBridge to trigger scheduled tasks.
ENABLE_SCHEDULER=true

# ------------------------------------------------------------------------------
# 6. AWS S3 FILE STORAGE (Cafe & Drink Photos)
# ------------------------------------------------------------------------------
# Leave AWS_S3_BUCKET empty for local development (falls back to backend/uploads/).
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=

# Optional: When running on AWS with IAM Roles (ECS task execution role or EC2 instance profile),
# leave access keys empty. AWS SDK will automatically resolve credentials via the IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 7. AWS SES TRANSACTIONAL EMAIL
# ------------------------------------------------------------------------------
# Set ENABLE_SES=true to deliver real emails via Amazon Simple Email Service (SES).
# In local development (ENABLE_SES=false), emails are safely simulated in the console.
ENABLE_SES=false
EMAIL_FROM="Social Cup <noreply@socialcup.com>"
AWS_SES_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. RESEND TRANSACTIONAL EMAIL (alternative to SES - no AWS account needed)
# ------------------------------------------------------------------------------
# If set, takes precedence over SES. EMAIL_FROM above must be a sender/domain
# verified in your Resend account, or Resend's own sandbox address
# (onboarding@resend.dev) for testing before you've verified a domain.
RESEND_API_KEY=
